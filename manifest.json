{
  "manifest_version": 3,
  "name": "Abseil",
  "version": "1.0.0",
  "description": "A toolkit that rappels into the current page and brings back what you need: download page fonts on any site, every full-resolution image on a Pinterest board, or every image in a Behance project.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Abseil — download fonts & images from the current page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pinterest.com/*",
        "https://*.pinterest.de/*",
        "https://*.pinterest.at/*",
        "https://*.pinterest.ch/*",
        "https://*.pinterest.fr/*",
        "https://*.pinterest.es/*",
        "https://*.pinterest.it/*",
        "https://*.pinterest.co.uk/*",
        "https://*.pinterest.ca/*",
        "https://*.pinterest.com.au/*",
        "https://*.pinterest.com.mx/*",
        "https://*.pinterest.jp/*",
        "https://*.pinterest.se/*",
        "https://*.pinterest.dk/*",
        "https://*.pinterest.nz/*",
        "https://*.pinterest.ie/*",
        "https://*.pinterest.pt/*"
      ],
      "js": ["modules/pinterest/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.behance.net/*", "https://behance.net/*"],
      "js": ["modules/behance/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
